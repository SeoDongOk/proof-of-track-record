{
  "name": "proof-of-track-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "compact compile contracts/track_record.compact build/track_record",
    "proof-server": "docker run -d --name ptr-proof-server -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v",
    "demo": "node src/demo.mjs",
    "live": "node src/live-proof.mjs",
    "export": "python src/export_trades.py --out trades.json",
    "live:real": "node src/live-proof.mjs --trades trades.json --batch 0 && node src/live-proof.mjs --trades trades.json --batch 1",
    "deploy": "node src/deploy.mjs",
    "nav": "node src/nav-demo.mjs",
    "nav:proof": "node src/nav-proof.mjs",
    "selection": "node src/selection-demo.mjs",
    "selection:proof": "node src/selection-proof.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/wallet": "^5.0.0",
    "@midnight-ntwrk/wallet-api": "^5.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "^4.1.1"
  }
}
