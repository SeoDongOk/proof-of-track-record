# ─────────────────────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 채우세요. .env 는 gitignore 되어 있습니다.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Primus zkTLS 공증인 네트워크 자격증명 (npm run attest:live 에 필요)
#   https://dev.primuslabs.xyz/myDevelopment/myProjects 에서 프로젝트 생성 후 발급
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# 바이낸스 현물 계좌 증명용 (npm run attest:binance 에만 필요)
#   ⚠️ 읽기 전용(Enable Reading) 키만 쓰세요. 출금 권한은 절대 켜지 마세요.
#   ⚠️ 이 키는 zkTLS 요청 헤더로 들어갑니다. 체인에는 키의 해시만 올라갑니다.
BINANCE_API_KEY=
BINANCE_API_SECRET=
