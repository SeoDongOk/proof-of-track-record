pragma language_version 0.23;
import CompactStandardLibrary;

// ============================================================================
// Proof of Track Record
//
// 트레이더가 전략과 개별 거래를 공개하지 않고 성과를 증명한다.
//
// 공개되는 것: 전략 커밋 해시, 거래 커밋들의 머클 루트, 거래 건수,
//              검증에 성공한 "주장"(수익률 하한, 리스크 상한)
// 비공개인 것: 전략 파라미터, 개별 체결 내역, 포지션 비중
// ============================================================================

/** 거래 1건. 회로 안에서만 존재하며 원장에는 커밋 해시만 남는다. */
export struct Trade {
  /** 체결 시각 (unix seconds) */
  timestamp: Uint<64>;
  /** 손익. 부호를 피하려고 오프셋 인코딩: 실제 bp = pnlBps - PNL_OFFSET */
  pnlBps: Uint<32>;
  /** 재현 방지용 난수 (같은 손익이어도 커밋이 달라지게) */
  salt: Bytes<32>;
}

/** pnlBps 오프셋. 100_000 = 0bp, 그보다 작으면 손실. */
export circuit pnlOffset(): Uint<32> {
  return 100000;
}

// ── 공개 원장 ───────────────────────────────────────────────────────────────

/** 현재 증명 대상 전략의 커밋 */
export ledger strategyCommitment: Bytes<32>;

/** 전략이 커밋됐는지 */
export ledger strategyLocked: Boolean;

// ── 전략 시행 레지스트리 ────────────────────────────────────────────────────
//
// 한 컨트랙트 안에서 전략을 못 바꾸게 하는 것만으로는 부족하다.
// 컨트랙트를 10개 배포하고 이긴 하나만 보여주면 그만이기 때문이다.
//
// 그래서 트레이더 식별자별로 **등록한 전략 개수를 공개**한다.
// 시행 자체를 막을 수는 없다. 다만 몇 번 시도했는지를 숨길 수 없게 만든다.
// 검증자는 "이 사람은 10개를 등록했고 그중 하나를 보여주고 있다"를 알게 된다.

/** 트레이더 ID -> 등록한 전략 개수 (공개) */
export ledger strategyCount: Map<Bytes<32>, Uint<64>>;

/** hash(트레이더 ID, 순번) -> 전략 커밋 해시 (공개) */
export ledger strategyLedger: Map<Bytes<32>, Bytes<32>>;

/** 거래가 발생할 때마다 커밋을 누적하는 머클 트리 (최대 2^10 = 1024건) */
export ledger tradeLog: HistoricMerkleTree<10, Bytes<32>>;

/** 기록된 거래 건수 */
export ledger tradeCount: Counter;

// ── 비공개 입력 ─────────────────────────────────────────────────────────────

/** 전략 파라미터 원문 (해시만 공개된다) */
witness strategyParams(): Bytes<32>;

/** 커밋 개봉용 난수 */
witness strategyOpening(): Bytes<32>;

/** 이번에 기록할 거래 */
witness nextTrade(): Trade;

// ── 회로 1: 전략 사전 커밋 ──────────────────────────────────────────────────

/**
 * 단일 전략 커밋. 한 컨트랙트 안에서 전략이 바뀌지 않음을 보장한다.
 *
 * 이것만으로는 "컨트랙트 10개 배포 후 이긴 것만 공개" 를 못 막는다.
 * 그건 registerStrategy / provenanceOf 가 담당한다.
 */
export circuit commitStrategy(): [] {
  assert(!strategyLocked, "strategy already committed");
  const params = strategyParams();
  const opening = strategyOpening();
  // persistentCommit(값, 개봉난수) -> 커밋 해시. 해시만 공개 대상이다.
  strategyCommitment.write(disclose(persistentCommit<Bytes<32>>(params, opening)));
  strategyLocked.write(true);
}

/**
 * 전략을 트레이더 레지스트리에 등록한다.
 *
 * 원장에 남는 것은 (a) 이 트레이더가 지금까지 등록한 전략 개수 (b) 각 전략의
 * 커밋 해시뿐이다. 파라미터는 드러나지 않는다.
 *
 * 요점은 개수가 **공개**라는 것이다. 10개를 등록하고 하나만 증명해도
 * 검증자는 strategyCount 에서 10 을 읽는다. 시행 횟수를 숨길 수 없다.
 */
export circuit registerStrategy(traderId: Bytes<32>): [] {
  const params = strategyParams();
  const opening = strategyOpening();
  const commitment = persistentCommit<Bytes<32>>(params, opening);

  const prior = strategyCount.member(disclose(traderId))
    ? strategyCount.lookup(disclose(traderId))
    : 0;
  const index = (prior + 1) as Uint<64>;

  // 슬롯 키 = hash(트레이더 ID, 순번). 같은 트레이더의 n번째 전략을 가리킨다.
  const slot = persistentHash<[Bytes<32>, Uint<64>]>([disclose(traderId), disclose(index)]);

  strategyCount.insert(disclose(traderId), disclose(index));
  strategyLedger.insert(disclose(slot), disclose(commitment));
}

/**
 * "이 전략은 이 트레이더가 등록한 n번째이고, 총 등록 수는 N 이다"를 확인한다.
 *
 * 성과 증명과 함께 쓰면 검증자는 분모를 알게 된다. 10개 중 1개를 보고 있다는
 * 사실이 드러나므로, 이긴 것만 골라 보여주는 것이 무의미해진다.
 */
export circuit provenanceOf(traderId: Bytes<32>, index: Uint<64>): Uint<64> {
  const params = strategyParams();
  const opening = strategyOpening();
  const commitment = persistentCommit<Bytes<32>>(params, opening);

  const slot = persistentHash<[Bytes<32>, Uint<64>]>([disclose(traderId), disclose(index)]);

  assert(strategyLedger.member(disclose(slot)), "no strategy at that slot");
  assert(strategyLedger.lookup(disclose(slot)) == commitment,
         "strategy does not match the registered commitment");

  // 반환값이 곧 분모다. 이 트레이더가 등록한 전략 총 개수.
  return strategyCount.lookup(disclose(traderId));
}

/**
 * 나중에 전략을 공개하고 싶을 때, 커밋과 일치함을 증명한다.
 * (해커톤 데모에서 "사후 조작이 없었다"를 보여주는 용도)
 */
export circuit revealMatchesCommitment(): Boolean {
  const params = strategyParams();
  const opening = strategyOpening();
  return disclose(persistentCommit<Bytes<32>>(params, opening) == strategyCommitment);
}

// ── 회로 2: 거래 기록 ───────────────────────────────────────────────────────

/**
 * 거래 1건을 머클 트리에 커밋한다.
 * 체결 내역은 witness 로만 존재하고, 원장에는 해시만 들어간다.
 * 발생 시점마다 온체인에 남으므로 나중에 손실 거래를 지울 수 없다.
 */
export circuit recordTrade(): [] {
  assert(strategyLocked, "commit strategy first");
  const t = nextTrade();
  // insert() 는 값을 넣으면 트리가 리프 해싱을 한다.
  // insertHash() 는 리프 해싱을 건너뛰는데, TypeScript 쪽 findPathForLeaf 는
  // 항상 리프 해싱을 적용하므로 짝이 맞지 않는다. insert() 로 규약을 통일한다.
  // 넣는 값 자체가 이미 거래의 해시이므로 내용은 드러나지 않는다.
  const leaf = persistentHash<Trade>(t);
  tradeLog.insert(disclose(leaf));
  tradeCount.increment(1);
}

// ── 회로 3: 수익률 임계값 증명 ──────────────────────────────────────────────
//
// 회로 안에서는 가변 변수(let)를 쓸 수 없다. 배치 크기를 8로 고정하고
// 합계를 펼쳐 쓴다. 배치를 키우려면 이 부분과 witness 크기를 함께 바꾼다.

/** 검증에 성공한 누적 손익 하한 (오프셋 인코딩, 8건 기준) */
export ledger provenPnlFloor: Uint<64>;
/** 그 주장이 근거로 삼은 거래 건수 */
export ledger provenTradeCount: Uint<64>;

/** 증명 대상 거래 8건 */
witness provenTrades(): Vector<8, Trade>;
/** 각 거래의 머클 경로 */
witness provenPaths(): Vector<8, MerkleTreePath<10, Bytes<32>>>;

/**
 * "이 8건은 모두 커밋된 로그 안에 있고, 손익 합계가 claimedFloor 이상이다"를
 * 증명한다. 개별 거래의 시각·손익은 공개되지 않는다.
 *
 * 각 거래에 대해 두 가지를 강제한다.
 *   1) 제출된 머클 경로의 잎이 그 거래의 해시와 같다  (거래 바꿔치기 차단)
 *   2) 그 경로의 루트가 원장이 아는 루트다            (없던 거래 끼워넣기 차단)
 */
export circuit proveReturnAtLeast(claimedFloor: Uint<64>): [] {
  const trades = provenTrades();
  const paths = provenPaths();

  for (const i of 0..8) {
    assert(paths[i].leaf == persistentHash<Trade>(trades[i]),
           "merkle path does not match the trade");
    // 루트는 이미 원장에 공개돼 있다. "어느 루트에 대해 증명하는가"가
    // 드러나는 것은 의도된 공개이므로 disclose() 로 명시한다.
    assert(tradeLog.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(paths[i]))),
           "trade is not in the committed log");
  }

  const total = (trades[0].pnlBps as Uint<64>) + (trades[1].pnlBps as Uint<64>)
              + (trades[2].pnlBps as Uint<64>) + (trades[3].pnlBps as Uint<64>)
              + (trades[4].pnlBps as Uint<64>) + (trades[5].pnlBps as Uint<64>)
              + (trades[6].pnlBps as Uint<64>) + (trades[7].pnlBps as Uint<64>);

  assert(total >= claimedFloor, "claimed floor not met");

  // 공개되는 것은 "하한 주장"과 근거 건수뿐. 합계 실제값도 공개하지 않는다.
  provenPnlFloor.write(disclose(claimedFloor));
  provenTradeCount.write(8);
}

// ── 회로 4: 리스크 한도 준수 증명 ───────────────────────────────────────────
//
// "종목당 비중이 X% 를 넘지 않았다"를 포지션을 드러내지 않고 증명한다.
// 감사·규제 대응이나 LP 보고에서 실제로 필요한 형태다.

/** 포지션 스냅샷 커밋 */
export ledger portfolioCommitment: Bytes<32>;
/** 포트폴리오가 커밋됐는지 */
export ledger portfolioLocked: Boolean;
/** 준수가 증명된 종목당 비중 상한 (bp) */
export ledger provenMaxWeightBps: Uint<32>;

/** 종목별 비중 (bp, 10000 = 100%) */
witness portfolioWeights(): Vector<8, Uint<32>>;
/** 커밋 개봉용 난수 */
witness portfolioOpening(): Bytes<32>;

/** 현재 포지션 구성을 커밋한다. 비중 자체는 공개되지 않는다. */
export circuit commitPortfolio(): [] {
  const w = portfolioWeights();
  portfolioCommitment.write(
    disclose(persistentCommit<Vector<8, Uint<32>>>(w, portfolioOpening())));
  portfolioLocked.write(true);
}

/**
 * 커밋된 포트폴리오가 리스크 한도를 지켰음을 증명한다.
 *   1) 제시한 비중이 커밋과 일치       (포트폴리오 바꿔치기 차단)
 *   2) 모든 종목이 limitBps 이하
 *   3) 비중 합이 100% 이하
 * 공개되는 것은 "한도를 지켰다"는 사실과 그 한도값뿐이다.
 */
export circuit proveMaxWeight(limitBps: Uint<32>): [] {
  assert(portfolioLocked, "commit portfolio first");
  const w = portfolioWeights();

  assert(disclose(persistentCommit<Vector<8, Uint<32>>>(w, portfolioOpening()))
           == portfolioCommitment,
         "weights do not match the committed portfolio");

  for (const i of 0..8) {
    assert(w[i] <= limitBps, "position exceeds the risk limit");
  }

  const sum = (w[0] as Uint<64>) + (w[1] as Uint<64>)
            + (w[2] as Uint<64>) + (w[3] as Uint<64>)
            + (w[4] as Uint<64>) + (w[5] as Uint<64>)
            + (w[6] as Uint<64>) + (w[7] as Uint<64>);
  assert(sum <= 10000, "weights sum to more than 100%");

  provenMaxWeightBps.write(disclose(limitBps));
}

// ── 회로 5: NAV 델타 증명 (완전성 보장) ────────────────────────────────────
//
// 회로 3(거래 로그 합계)에는 구멍이 있다. 로그에 무엇을 넣을지 고르는 주체가
// 트레이더 본인이므로, 손실 거래를 애초에 커밋하지 않으면 남은 것만으로
// 참인 주장을 만들 수 있다. ZK 는 "계산이 정직했다"를 증명할 뿐
// "입력이 전부다"를 증명하지 않는다.
//
// NAV(계좌 순자산) 델타는 이 구멍을 막는다. 거래를 빼도 잔고는 그대로다.
// 기간 시작 NAV 를 미리 커밋해 두므로 사후에 낮춰 수익률을 부풀릴 수도 없다.

/** 기간 시작 시점 NAV 커밋 */
export ledger navOpenCommitment: Bytes<32>;
/** 기간 종료 시점 NAV 커밋 */
export ledger navCloseCommitment: Bytes<32>;
export ledger navPeriodOpen: Boolean;
export ledger navPeriodClosed: Boolean;
/** 검증된 수익률 하한 (오프셋 인코딩: 10000 = 0%) */
export ledger provenReturnBps: Uint<16>;

/** 수익률 오프셋. 10000 = 0bp, 65535 상한이므로 최대 +555% 까지 주장 가능 */
export circuit returnOffset(): Uint<16> {
  return 10000;
}

// NAV 는 Uint<48> (약 2.8e14). 통화 최소단위 기준이면 충분하고,
// Uint<48> * Uint<16> = Uint<64> 로 곱셈이 오버플로 없이 들어간다.
witness navOpenValue(): Uint<48>;
witness navOpenSalt(): Bytes<32>;
witness navCloseValue(): Uint<48>;
witness navCloseSalt(): Bytes<32>;

/** 기간 시작. 결과를 알기 전에 NAV 를 못 박는다. */
export circuit openNavPeriod(): [] {
  assert(!navPeriodOpen, "nav period already open");
  navOpenCommitment.write(
    disclose(persistentCommit<Uint<48>>(navOpenValue(), navOpenSalt())));
  navPeriodOpen.write(true);
}

/** 기간 종료. */
export circuit closeNavPeriod(): [] {
  assert(navPeriodOpen, "open a nav period first");
  assert(!navPeriodClosed, "nav period already closed");
  navCloseCommitment.write(
    disclose(persistentCommit<Uint<48>>(navCloseValue(), navCloseSalt())));
  navPeriodClosed.write(true);
}

/**
 * "이 기간 수익률이 claimedBps 이상"을 증명한다. NAV 값 자체는 공개하지 않는다.
 *
 * r = (close - open) / open 이므로, claimedBps 를 오프셋 인코딩(10000=0%)하면
 *   close * 10000 >= open * claimedBps
 * 가 곧 r >= (claimedBps - 10000) 이다. 부호 없는 정수만으로 손실도 표현된다.
 */
export circuit proveNavReturnAtLeast(claimedBps: Uint<16>): [] {
  assert(navPeriodOpen, "no nav period");
  assert(navPeriodClosed, "nav period not closed");

  const o = navOpenValue();
  const c = navCloseValue();

  assert(disclose(persistentCommit<Uint<48>>(o, navOpenSalt())) == navOpenCommitment,
         "open nav does not match its commitment");
  assert(disclose(persistentCommit<Uint<48>>(c, navCloseSalt())) == navCloseCommitment,
         "close nav does not match its commitment");
  assert(o > 0, "open nav must be positive");

  // Uint<48> * Uint<16> = Uint<64>. 오버플로 없이 교차곱으로 비교한다.
  assert(c * returnOffset() >= o * claimedBps, "claimed return not met");

  provenReturnBps.write(disclose(claimedBps));
}

// ── 회로 7: 제3자 증언 (공증인 인터페이스) ──────────────────────────────────
//
// 회로 5(NAV 델타)까지 와도 마지막 가정이 남는다. NAV 를 처음부터 지어내면
// 커밋은 "내가 말한 값을 안 바꿨다" 만 보장할 뿐이다.
//
// 블록체인 안에서 바깥 사실("내 거래소 잔고가 X 다")을 증명하려면 그걸
// 목격한 무언가가 반드시 필요하다. 없앨 수 있는 한계가 아니다.
// Obscura 는 TEE+API 로, zkTLS(TLSNotary/Reclaim)는 공증인으로 푼다.
// 이름만 다를 뿐 전부 공증인이다. 그래서 숨기지 않고 슬롯으로 드러낸다.
//
// 설계의 요점: **서명 검증을 회로 밖으로 뺀다.**
//   1. 공증인이 거래소 TLS 세션에서 잔고를 읽고
//      (계좌ID, NAV커밋) 에 서명해 온체인에 올린다
//   2. 서명 검증은 체인/검증자가 일반 도구로 한다 — 회로가 할 필요가 없다
//   3. 회로는 "내 비공개 NAV 가 그 커밋을 연다" 만 증명한다
//
// 덕분에 Compact 0.31 에서 오늘 동작한다. 회로 안에서 서명을 검증하려면
// 0.34 의 secp256k1EcdsaVerify 가 필요하지만, 그럴 이유가 없다.

/** 공증인 식별자 (공개). 배포 시 등록하고 이후 바꾸지 않는다. */
export ledger attestorId: Bytes<32>;
export ledger attestorRegistered: Boolean;

/** 거래소 계좌ID -> 공증된 NAV 커밋 */
export ledger attestations: Map<Bytes<32>, Bytes<32>>;

/** 공증인이 증언한 계좌 수 (공개) */
export ledger attestationCount: Counter;

/** 공증인을 등록한다. */
export circuit registerAttestor(id: Bytes<32>): [] {
  assert(!attestorRegistered, "attestor already registered");
  attestorId.write(disclose(id));
  attestorRegistered.write(true);
}

/**
 * 공증인이 증언을 올린다.
 *
 * 여기 들어오는 커밋은 공증인이 만든 것이다. 트레이더가 아니다.
 * 서명 자체는 이 트랜잭션을 올린 주체가 공증인인지로 확인한다
 * (실전에서는 공증인만 이 회로를 호출할 수 있게 권한을 건다).
 *
 * accountId 는 거래소 계좌 식별자의 해시다. 이게 Sybil 대응의 핵심이다 —
 * 신원을 지갑이 아니라 KYC 된 거래소 계좌에 묶으면, 신원 10개를 만들려면
 * KYC 계좌 10개가 필요하다.
 */
export circuit submitAttestation(accountId: Bytes<32>, navCommitment: Bytes<32>): [] {
  assert(attestorRegistered, "register an attestor first");
  assert(!attestations.member(disclose(accountId)), "account already attested");
  attestations.insert(disclose(accountId), disclose(navCommitment));
  attestationCount.increment(1);
}

/**
 * "내 비공개 NAV 가 공증인이 올린 커밋을 연다"를 증명한다.
 *
 * 공증이 없으면 증명 자체가 불가능하다. 트레이더가 NAV 를 지어내도
 * 공증된 커밋과 맞지 않으므로 회로가 멈춘다.
 * NAV 값 자체는 끝까지 공개되지 않는다.
 */
export circuit proveAttestedNav(accountId: Bytes<32>): [] {
  assert(attestations.member(disclose(accountId)), "no attestation for that account");
  const commitment = persistentCommit<Uint<48>>(navOpenValue(), navOpenSalt());
  assert(attestations.lookup(disclose(accountId)) == disclose(commitment),
         "nav does not open the attested commitment");
}
